Imports System

Module Program
    Sub Main()
        Dim a As Integer = 17, b As Integer = 4
        Console.WriteLine($"a+b = {a+b}")
        Console.WriteLine($"a-b = {a-b}")
        Console.WriteLine($"a*b = {a*b}")
        Console.WriteLine($"a/b = {a/b:F2}")
        Console.WriteLine($"a\b = {a\b}")
        Console.WriteLine($"a Mod b = {a Mod b}")
        Console.WriteLine($"a^2 = {a^2}")
    End Sub
End Module
